{
  "expo": {
    "name": "Healzo",
    "slug": "healzo",
    "scheme": "healzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F8F6",
    "primaryColor": "#0E8F88",
    "owner": "endosurgerys-team",
    "description": "Healzo helps families build healthy screen habits: kind daily limits, screen-free activities, gardening, rewards and streaks.",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "url": "https://u.expo.dev/0031b1e7-12c4-4ccd-b220-724c6db142f0" },
    "ios": {
      "bundleIdentifier": "com.healzo.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.healzo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#12324A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "resizeMode": "contain", "backgroundColor": "#12324A" }],
      ["expo-notifications", { "color": "#0E8F88" }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "eas": { "projectId": "0031b1e7-12c4-4ccd-b220-724c6db142f0" }, "router": {} }
  }
}
